{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equity-on-sign-staging",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/cloudflare/worker.ts",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "vars": {
    "APP_URL": "https://equity-on-sign-staging.workers.dev",
    "DATABASE_DRIVER": "d1",
    "EMAIL_CAPTURE_FALLBACK": "1",
    "STORAGE_DRIVER": "r2"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "equity-on-sign-staging",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "equity-on-sign-staging"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ]
}
